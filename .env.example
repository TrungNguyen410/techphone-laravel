APP_NAME=TechPhone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL chạy trong Docker (service "db"). Từ máy host kết nối qua cổng 3307.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=techphone
DB_USERNAME=techphone
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@techphone.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Mật khẩu chung của các tài khoản mẫu khi chạy seeder.
SEED_PASSWORD=123456

# Thanh toán VNPay (sandbox). Đăng ký tại https://sandbox.vnpayment.vn để lấy mã.
# Để trống thì phương thức "Thẻ/QR qua VNPay" sẽ tự ẩn ở trang thanh toán.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/return"

# Chuyển khoản ngân hàng / MoMo (hiển thị mã QR, nhân viên đối soát thủ công).
# Số tài khoản dưới đây chỉ là dữ liệu minh họa.
BANK_NAME="Vietcombank"
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME="TECHPHONE DEMO"
MOMO_PHONE=0900000000
MOMO_ACCOUNT_NAME="TECHPHONE DEMO"

# Gửi OTP qua SMS bằng Twilio. Để trống thì môi trường dev hiển thị mã OTP thử nghiệm.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
