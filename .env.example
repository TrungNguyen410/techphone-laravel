APP_NAME=TechPhone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL chạy trong Docker (service "db"). Từ máy host kết nối qua cổng 3307.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=techphone
DB_USERNAME=techphone
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="support@techphone.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Mật khẩu chung của các tài khoản mẫu khi chạy seeder.
SEED_PASSWORD=123456

# Thanh toán VNPay (sandbox). Đăng ký tại https://sandbox.vnpayment.vn để lấy mã.
# Để trống thì phương thức "Thẻ/QR qua VNPay" sẽ tự ẩn ở trang thanh toán.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/return"

# Chuyển khoản ngân hàng / MoMo (hiển thị mã QR, nhân viên đối soát thủ công).
# Số tài khoản dưới đây chỉ là dữ liệu minh họa.
BANK_NAME="Vietcombank"
BANK_BIN=970436
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_NAME="TECHPHONE DEMO"
MOMO_PHONE=0900000000
MOMO_ACCOUNT_NAME="TECHPHONE DEMO"

# Chuyển khoản tự động qua SePay: tạo webhook trỏ tới {APP_URL}/payment/sepay/webhook, kiểu xác thực "API Key",
# rồi đặt cùng giá trị ở đây. Để trống thì nhân viên đối soát chuyển khoản thủ công như trước.
SEPAY_WEBHOOK_API_KEY=

# Chatbot AI (Google Gemini). Lấy API key miễn phí tại https://aistudio.google.com/apikey.
# Để trống thì chatbot vẫn chạy ở chế độ offline (trả lời theo luật trên dữ liệu thật của cửa hàng).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Đăng nhập Google/Facebook qua Firebase Authentication (lấy trong Project settings → Your apps → Web app).
# Để trống thì nút đăng nhập Google/Facebook tự ẩn.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Gửi OTP qua SMS bằng Twilio. Để trống thì môi trường dev hiển thị mã OTP thử nghiệm.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
