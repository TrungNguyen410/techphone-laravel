<mxfile host="drawio" version="26.0.0"><diagram name="activity-dat-hang-thanh-toan"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Activity – Đặt hàng và thanh toán" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="505" y="50" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Thêm sản phẩm vào giỏ&#xa;(giá, tồn kho lấy lại từ CSDL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="240" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Nhập mã giảm giá (tùy chọn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="200" width="240" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Đã đăng nhập?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="200" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Đăng nhập / Đăng ký" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="305" width="200" height="50" as="geometry"/></mxCell><mxCell id="c8" value="Chọn địa chỉ đã lưu hoặc&#xa;nhập địa chỉ mới (tỉnh + phường/xã)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="280" height="50" as="geometry"/></mxCell><mxCell id="c9" value="Chọn phương thức thanh toán&#xa;&amp; bấm Đặt hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex